# Keeps the container-mode build context (docker/Dockerfile, RAL-225) small
# and avoids baking host build artifacts into the image.
target/
dist/
.git/
cli-py/.venv/
cli-py/**/__pycache__/
cli-py/.mypy_cache/
cli-py/.ruff_cache/
cli-py/.pytest_cache/
node_modules/
.lint-tmp/
.claude/
.docker-ssh-target/
.pytest_cache/
logs/
bundle-dist/
bench_data/
docs/site/_site/
*.local.md
