            VALUE "InternalName", "ralphus-daemon"
            VALUE "OriginalFilename", "ralphus-daemon.exe"
            VALUE "ProductName", "Ralphus"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
