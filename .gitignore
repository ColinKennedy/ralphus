# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# ralphus runtime state (daemon DB, pid files, logs)
*.db
*.db-wal
*.db-shm
*.pid
/.ralphus/
/.docker-ssh-target/
# Task worktrees created at runtime. (Guardian review worktrees now live under
# .git/.ralphus_guardian/, which git already excludes — no entry needed.)
/.worktrees/

# Node (lint/type-check tooling for the librarian's board chunk JS — see
# package.json)
node_modules/
# lint/typecheck/knip scratch output (generated board globals, etc.)
/.lint-tmp/

# Docs site build output (docs/site/pages/*.md -> HTML). The screenshots
# under docs/site/pages/screenshots/ ARE committed — only this render is not.
/docs/site/_site/

# Secure distribution — private key must never be committed
ralphus-private.key
ralphus.lic

# Editors / OS
.DS_Store
*.local.md.bak

# Build artifacts
bundle-dist/
