# syntax=docker/dockerfile:1.7

# The work image plus the real Claude Code CLI, as an example of what an
# operator layers on top of `docker/remote-agent/Dockerfile` to run real agent
# cells on a container-backed machine. Build the base first:
#
#   docker build -f docker/remote-agent/Dockerfile -t ralphus-remote-agent:test .
#   docker build -f docker/remote-agent/Dockerfile.claude-code \
#       -t ralphus-remote-agent:claude-code .
#
# Credentials are NOT baked in. Give the container its own `~/.claude`
# (a bind mount of a directory holding a copy of `.credentials.json`) or an API
# key through the cell's environment; see docs/machine-providers.md.

ARG BASE=ralphus-remote-agent:test
FROM ${BASE}

USER root
# Claude Code needs Node >= 22; Debian's own nodejs is older, so take Node from
# the official image instead.
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
# The base image ships a deterministic mock `claude` for credential-free tests
# at the path npm wants for the real one; remove it so `claude` is the real CLI.
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && rm -f /usr/local/bin/claude \
    && npm install -g @anthropic-ai/claude-code \
    && rm -rf /root/.npm \
    && claude --version

USER ralphus
WORKDIR /home/ralphus
